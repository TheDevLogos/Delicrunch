# Copy this file to .env for local development. Never commit .env or real credentials.
# Prefer the Supabase Session Pooler URI from Supabase Connect.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<session-pooler-host>:5432/postgres?sslmode=require
DB_USER=postgres.<project-ref>
DB_HOST=<session-pooler-host>
DB_DATABASE=postgres
DB_PASSWORD=
DB_PORT=5432

SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<publishable-key>
SUPABASE_SERVICE_KEY=<server-only-secret-key>
JWT_SECRET=<random-long-secret>

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_ACCESS_TOKEN=<server-only-access-token>
MERCADOPAGO_USER_ID=
MERCADOPAGO_APP_ID=

FRONTEND_URL=http://localhost:8081
BACKEND_URL=http://localhost:5001
APP_SCHEME=delicrunch
PORT=5001
