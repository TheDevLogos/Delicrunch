{
  "expo": {
    "name": "Delicrunch",
    "slug": "delicrunch-frontend",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "delicrunch",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "splash": {
      "image": "./assets/Crunchy.png",
      "resizeMode": "contain",
      "backgroundColor": "#F46A16"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.delicrunch.app"
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F46A16"
      },
      "package": "com.delicrunch.app",
      "versionCode": 4,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "web": {
            "build": {
              "babel": {
                "include": [
                  "react-native-vector-icons"
                ]
              }
            }
          },
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableMinifyInReleaseBuilds": true,
            "newArchEnabled": true
          },
          "ios": {
            "newArchEnabled": true
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite elegir una foto para tu perfil o la imagen de tu comercio.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-font",
      "expo-video",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#F46A16",
          "defaultChannel": "orders"
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://delicrunch.onrender.com/api",
      "eas": {
        "projectId": "266fa507-5eba-4cf8-b44f-0aa42d08a694"
      }
    },
    "owner": "alonsovl88"
  }
}
